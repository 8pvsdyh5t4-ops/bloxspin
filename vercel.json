{
  "buildCommand": "node scripts/build.cjs",
  "outputDirectory": "dist",
  "functions": {
    "api/game.js": { "maxDuration": 60 },
    "api/admin.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
